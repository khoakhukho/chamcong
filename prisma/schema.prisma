// Prisma schema for CHAMCONG - Caritas Dalat Attendance Webapp

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int               @id @default(autoincrement())
  employeeCode         String            @unique // e.g., vnxkhoa, admin, ketoan
  fullName             String
  passwordHash         String
  phone                String?
  email                String?
  department           String?           // e.g., Ban Giám Đốc, Ban Y Tế, Ban Khuyết Tật, Ban Học Bổng, Hành Chính
  role                 String            @default("EMPLOYEE") // "ADMIN", "ACCOUNTANT", "MANAGER", "EMPLOYEE"
  contractType         String            @default("FULL_TIME") // "FULL_TIME", "PART_TIME", "CONTRACT"
  joinDate             DateTime          @default(now())
  annualLeaveBase      Float             @default(12.0)
  avatarUrl            String?
  telegramId           String?           @unique
  isActive             Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  attendances          Attendance[]
  leaveRequests        LeaveRequest[]    @relation("UserLeaveRequests")
  approvedRequests     LeaveRequest[]    @relation("ApprovedRequests")
  notifications        Notification[]
  createdAnnouncements Announcement[]    @relation("CreatedAnnouncements")
  announcementAcks     AnnouncementAck[]

  // Projects Relations
  projectMemberships   ProjectMember[]
  submittedReports     ProjectReport[]   @relation("UserSubmittedReports")
  approvedReports      ProjectReport[]   @relation("ApprovedReports")
  uploadedFiles        ProjectFile[]
}

model Shift {
  id                  Int          @id @default(autoincrement())
  name                String       // e.g., "Ca Hành Chính (8:00 - 17:00)"
  startTime           String       // "08:00"
  endTime             String       // "17:00"
  allowedLateMinutes  Int          @default(15)
  allowedEarlyMinutes Int          @default(15)
  isActive            Boolean      @default(true)
  createdAt           DateTime     @default(now())

  attendances         Attendance[]
}

model Location {
  id          Int      @id @default(autoincrement())
  name        String   // e.g., "Văn phòng Caritas Đà Lạt (Tòa Giám Mục)"
  address     String?
  latitude    Float
  longitude   Float
  radiusMeters Float   @default(150.0) // Allowed check-in radius in meters
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  attendances Attendance[]
}

model Attendance {
  id                  Int       @id @default(autoincrement())
  userId              Int
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftId             Int?
  shift               Shift?    @relation(fields: [shiftId], references: [id])
  locationId          Int?
  location            Location? @relation(fields: [locationId], references: [id])
  
  checkType           String    // "IN" or "OUT"
  serverTime          DateTime  @default(now())
  clientCapturedTime  DateTime?
  
  // Geolocation Data
  latitude            Float?
  longitude           Float?
  locationAddress     String?
  distanceMeters      Float?
  isValidLocation     Boolean   @default(true)
  nearestLocationName String?
  
  // Face / Image Data
  imagePath           String?   // Local file path or base64 data URL
  
  // Evaluation
  isLate              Boolean   @default(false)
  lateMinutes         Int       @default(0)
  isEarlyLeave        Boolean   @default(false)
  earlyMinutes        Int       @default(0)
  status              String    @default("VALID") // "VALID", "INVALID", "PENDING_REVIEW"
  
  notes               String?
  createdAt           DateTime  @default(now())

  @@index([userId, serverTime])
  @@index([serverTime])
}

model LeaveRequest {
  id           Int       @id @default(autoincrement())
  userId       Int
  user         User      @relation("UserLeaveRequests", fields: [userId], references: [id], onDelete: Cascade)
  leaveType    String    // "ANNUAL", "COMPENSATORY", "SICK", "PERSONAL", "UNPAID"
  fromDate     DateTime
  toDate       DateTime
  daysCount    Float     @default(1.0)
  reason       String
  status       String    @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  approvedById Int?
  approvedBy   User?     @relation("ApprovedRequests", fields: [approvedById], references: [id])
  reviewNotes  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, fromDate])
}

model EmailOtp {
  id        Int      @id @default(autoincrement())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, code])
}

model Notification {
  id         Int      @id @default(autoincrement())
  userId     Int?     // If targeted to a specific user
  targetRole String?  // "ADMIN", "ACCOUNTANT", "MANAGER", "EMPLOYEE", "ALL"
  title      String
  content    String
  type       String   // "LEAVE_REQUEST", "LEAVE_APPROVED", "LEAVE_REJECTED", "ANNOUNCEMENT", "PROJECT_REPORT", "SYSTEM"
  link       String?  // Action URL
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([targetRole])
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  content     String
  category    String   @default("GENERAL") // "HOLIDAY", "SCHEDULE", "POLICY", "EVENT", "GENERAL"
  isPinned    Boolean  @default(false)
  requireAck  Boolean  @default(true)
  createdById Int
  createdBy   User     @relation("CreatedAnnouncements", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  acknowledgments AnnouncementAck[]

  @@index([isPinned, createdAt])
}

model AnnouncementAck {
  id             Int          @id @default(autoincrement())
  announcementId Int
  userId         Int
  acknowledgedAt DateTime     @default(now())

  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([announcementId])
  @@index([userId])
}

// ==================== PHASE 1: PROJECTS & REPORTS ====================

model Project {
  id           Int             @id @default(autoincrement())
  code         String          @unique // "PLD", "SKTT", "KHUYT_TAT", "HOC_BONG"
  name         String          // e.g. "Phát Triển Tự Dân"
  description  String?
  nasPath      String          @default("/volume1/CaritasData/")
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  members      ProjectMember[]
  reports      ProjectReport[]
  files        ProjectFile[]
}

model ProjectMember {
  id            Int      @id @default(autoincrement())
  projectId     Int
  userId        Int
  roleInProject String   @default("STAFF") // "COORDINATOR", "STAFF"
  joinedAt      DateTime @default(now())

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model ProjectReport {
  id           Int                  @id @default(autoincrement())
  projectId    Int
  userId       Int
  month        Int                  // 1..12
  year         Int                  // e.g. 2026
  title        String
  summary      String?
  wordDocUrl   String?              // URL path to Word document (.docx/.doc)
  wordDocName  String?              // Original file name
  wordDocSize  Int?                 // File size in bytes
  status       String               @default("SUBMITTED") // "SUBMITTED", "APPROVED", "REVISION_REQUESTED"
  approvedById Int?
  reviewNotes  String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User                 @relation("UserSubmittedReports", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy   User?                @relation("ApprovedReports", fields: [approvedById], references: [id])
  photos       ProjectReportPhoto[]

  @@index([projectId, year, month])
  @@index([userId])
}

model ProjectReportPhoto {
  id        Int           @id @default(autoincrement())
  reportId  Int
  photoUrl  String        // Local path or base64 WebP image
  caption   String?
  createdAt DateTime      @default(now())

  report    ProjectReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model ProjectFile {
  id           Int      @id @default(autoincrement())
  projectId    Int
  uploadedById Int
  fileName     String
  fileUrl      String
  fileType     String   @default("DOCUMENT") // "DOCUMENT", "IMAGE", "SPREADSHEET", "REPORT"
  fileSize     Int      @default(0)
  month        Int?
  year         Int?
  category     String   @default("GENERAL")
  createdAt    DateTime @default(now())

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([projectId, year, month])
}
